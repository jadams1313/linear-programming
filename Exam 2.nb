Cell[BoxData[
 RowBox[{
  RowBox[{"pivot", "[", 
   RowBox[{"iStar_", ",", "jStar_", ",", "tab_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"newTab", "=", "tab"}], ";", "\[IndentingNewLine]", 
    RowBox[{"nrows", "=", 
     RowBox[{
      RowBox[{"Dimensions", "[", "tab", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ncols", "=", 
     RowBox[{
      RowBox[{"Dimensions", "[", "tab", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"switch", " ", "row", " ", "variables"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"newTab", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "jStar"}], "]"}], "]"}], "=", 
     RowBox[{"tab", "[", 
      RowBox[{"[", 
       RowBox[{"iStar", ",", "ncols"}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"newTab", "[", 
      RowBox[{"[", 
       RowBox[{"iStar", ",", "ncols"}], "]"}], "]"}], "=", 
     RowBox[{"tab", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "jStar"}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"switch", " ", "row", " ", "variables"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"newTab", "[", 
      RowBox[{"[", 
       RowBox[{"iStar", ",", "1"}], "]"}], "]"}], "=", 
     RowBox[{"-", 
      RowBox[{"tab", "[", 
       RowBox[{"[", 
        RowBox[{"nrows", ",", "jStar"}], "]"}], "]"}]}]}], ";", 
    RowBox[{
     RowBox[{"newTab", "[", 
      RowBox[{"[", 
       RowBox[{"nrows", ",", "jStar"}], "]"}], "]"}], "=", 
     RowBox[{"-", 
      RowBox[{"tab", "[", 
       RowBox[{"[", 
        RowBox[{"iStar", ",", "1"}], "]"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "loop", " ", "over", " ", "numerical", " ", "portion", " ", "using", " ",
       "formulas"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"ii", "=", "2"}], ",", 
      RowBox[{"ii", "<", "nrows"}], ",", 
      RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"jj", "=", "2"}], ",", 
        RowBox[{"jj", "<", "ncols"}], ",", 
        RowBox[{"jj", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ii", "==", "iStar"}], "&&", 
             RowBox[{"jj", "==", "jStar"}]}], ",", 
            RowBox[{
             RowBox[{"newTab", "[", 
              RowBox[{"[", 
               RowBox[{"ii", ",", "jj"}], "]"}], "]"}], "=", 
             RowBox[{"1", "/", 
              RowBox[{"tab", "[", 
               RowBox[{"[", 
                RowBox[{"iStar", ",", "jStar"}], "]"}], "]"}]}]}]}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ii", "==", "iStar"}], "&&", 
             RowBox[{"jj", "!=", "jStar"}]}], ",", 
            RowBox[{
             RowBox[{"newTab", "[", 
              RowBox[{"[", 
               RowBox[{"ii", ",", "jj"}], "]"}], "]"}], "=", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"tab", "[", 
                RowBox[{"[", 
                 RowBox[{"ii", ",", "jj"}], "]"}], "]"}]}], "/", 
              RowBox[{"tab", "[", 
               RowBox[{"[", 
                RowBox[{"iStar", ",", "jStar"}], "]"}], "]"}]}]}]}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ii", "!=", "iStar"}], "&&", 
             RowBox[{"jj", "==", "jStar"}]}], ",", 
            RowBox[{
             RowBox[{"newTab", "[", 
              RowBox[{"[", 
               RowBox[{"ii", ",", "jj"}], "]"}], "]"}], "=", 
             RowBox[{
              RowBox[{"tab", "[", 
               RowBox[{"[", 
                RowBox[{"ii", ",", "jj"}], "]"}], "]"}], "/", 
              RowBox[{"tab", "[", 
               RowBox[{"[", 
                RowBox[{"iStar", ",", "jStar"}], "]"}], "]"}]}]}]}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ii", "!=", "iStar"}], "&&", 
             RowBox[{"jj", "!=", "jStar"}]}], ",", 
            RowBox[{
             RowBox[{"newTab", "[", 
              RowBox[{"[", 
               RowBox[{"ii", ",", "jj"}], "]"}], "]"}], "=", 
             RowBox[{
              RowBox[{"tab", "[", 
               RowBox[{"[", 
                RowBox[{"ii", ",", "jj"}], "]"}], "]"}], "-", 
              RowBox[{
               RowBox[{"tab", "[", 
                RowBox[{"[", 
                 RowBox[{"iStar", ",", "jj"}], "]"}], "]"}], 
               RowBox[{
                RowBox[{"tab", "[", 
                 RowBox[{"[", 
                  RowBox[{"ii", ",", "jStar"}], "]"}], "]"}], "/", 
                RowBox[{"tab", "[", 
                 RowBox[{"[", 
                  RowBox[{"iStar", ",", "jStar"}], "]"}], "]"}]}]}]}]}]}], 
           "]"}]}], "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", 
       "]"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Return", "[", "newTab", "]"}]}], "\[IndentingNewLine]", 
   ")"}]}]], "Input",

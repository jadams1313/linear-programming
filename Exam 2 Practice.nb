Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"pivot", "[", 
   RowBox[{"iStar_", ",", " ", "jStar_", ",", " ", "tableau_"}], "]"}], " ", ":=",
   " ", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"newTableau", " ", "=", " ", "tableau"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"numberRows", " ", "=", " ", 
     RowBox[{
      RowBox[{"Dimensions", "[", "tableau", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"numberCols", " ", "=", " ", 
     RowBox[{
      RowBox[{"Dimensions", "[", "tableau", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"switch", " ", "row", " ", "tableau", " ", "variables"}], " ", 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"newTableau", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "jStar"}], "]"}], "]"}], " ", "=", " ", 
     RowBox[{"tableau", "[", 
      RowBox[{"[", 
       RowBox[{"iStar", ",", " ", "numberCols"}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"newTableau", "[", 
      RowBox[{"[", 
       RowBox[{"iStar", ",", " ", "numberCols"}], "]"}], "]"}], " ", "=", " ", 
     RowBox[{"tableau", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "jStar"}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"switch", " ", "column", " ", "tableau", " ", "variables"}], " ",
      "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"newTableau", "[", 
      RowBox[{"[", 
       RowBox[{"numberRows", ",", "jStar"}], "]"}], "]"}], " ", "=", " ", 
     RowBox[{"-", 
      RowBox[{"tableau", "[", 
       RowBox[{"[", 
        RowBox[{"iStar", ",", " ", "1"}], "]"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"newTableau", "[", 
      RowBox[{"[", 
       RowBox[{"iStar", ",", " ", "1"}], "]"}], "]"}], " ", "=", " ", 
     RowBox[{"-", 
      RowBox[{"tableau", "[", 
       RowBox[{"[", 
        RowBox[{"numberRows", ",", "jStar"}], "]"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "adjust", " ", "loop", " ", "bounds", " ", "to", " ", "skip", " ", "1", 
      "st", " ", "column", " ", "and", " ", "last", " ", "row"}], " ", "*)"}],
     "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"ii", " ", "=", " ", "2"}], ",", " ", 
      RowBox[{"ii", " ", "<", " ", "numberRows"}], ",", " ", 
      RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"jj", "=", "2"}], ",", 
        RowBox[{"jj", "<", "numberCols"}], ",", 
        RowBox[{"jj", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ii", " ", "\[Equal]", " ", "iStar"}], " ", "&&", " ", 
            RowBox[{"jj", " ", "\[Equal]", " ", "jStar"}]}], ",", " ", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"newTableau", "[", 
             RowBox[{"[", 
              RowBox[{"ii", ",", "jj"}], "]"}], "]"}], "=", 
            RowBox[{"1", "/", 
             RowBox[{"tableau", "[", 
              RowBox[{"[", 
               RowBox[{"iStar", ",", " ", "jStar"}], "]"}], "]"}]}]}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ii", "\[Equal]", " ", "iStar"}], " ", "&&", " ", 
            RowBox[{"jj", " ", "\[NotEqual]", " ", "jStar"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"newTableau", "[", 
             RowBox[{"[", 
              RowBox[{"ii", ",", "jj"}], "]"}], "]"}], "=", " ", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"tableau", "[", 
               RowBox[{"[", 
                RowBox[{"iStar", ",", " ", "jj"}], "]"}], "]"}]}], "/", 
             RowBox[{"tableau", "[", 
              RowBox[{"[", 
               RowBox[{"iStar", ",", " ", "jStar"}], "]"}], "]"}]}]}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ii", " ", "\[NotEqual]", " ", "iStar"}], " ", "&&", " ", 
            RowBox[{"jj", " ", "\[Equal]", " ", "jStar"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"newTableau", "[", 
             RowBox[{"[", 
              RowBox[{"ii", ",", " ", "jj"}], "]"}], "]"}], "=", " ", 
            RowBox[{
             RowBox[{"tableau", "[", 
              RowBox[{"[", 
               RowBox[{"ii", ",", " ", "jStar"}], "]"}], "]"}], "/", 
             RowBox[{"tableau", "[", 
              RowBox[{"[", 
               RowBox[{"iStar", ",", " ", "jStar"}], "]"}], "]"}]}]}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ii", " ", "\[NotEqual]", " ", "iStar"}], " ", "&&", " ", 
            RowBox[{"jj", " ", "\[NotEqual]", " ", "jStar"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"newTableau", "[", 
             RowBox[{"[", 
              RowBox[{"ii", ",", "jj"}], "]"}], "]"}], " ", "=", " ", 
            RowBox[{
             RowBox[{"tableau", "[", 
              RowBox[{"[", 
               RowBox[{"ii", ",", "jj"}], "]"}], "]"}], "-", 
             RowBox[{
              RowBox[{"tableau", "[", 
               RowBox[{"[", 
                RowBox[{"iStar", ",", "jj"}], "]"}], "]"}], "*", 
              RowBox[{
               RowBox[{"tableau", "[", 
                RowBox[{"[", 
                 RowBox[{"ii", ",", " ", "jStar"}], "]"}], "]"}], "/", 
               RowBox[{"tableau", "[", 
                RowBox[{"[", 
                 RowBox[{"iStar", ",", "jStar"}], "]"}], "]"}]}]}]}]}]}], 
          "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
     "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Return", "[", "newTableau", "]"}], ";"}], "\[IndentingNewLine]", 
   ")"}]}], "\[IndentingNewLine]", 

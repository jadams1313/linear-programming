   RowBox[{"b4", "=", "20"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p1", "=", "9"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"$9", " ", "whether", " ", "buying", " ", "or", " ", "selling"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p2", "=", "22.50"}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"$15", " ", "for", " ", "the", " ", "first", " ", "400", "hrs"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 

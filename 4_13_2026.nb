    RowBox[{"10", "x1"}], "+", 
    RowBox[{"20", "x2"}]}]}], ";", 
  RowBox[{"b2", "=", "400"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g3", "[", 
    RowBox[{"x1_", ",", "x2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "x1"}], "+", 
    RowBox[{"0", "x2"}]}]}], ";", 
  RowBox[{"b3", "=", "25"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g3grph", "[", 
    RowBox[{"x1_", ",", "x2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "*", 
     RowBox[{"10", "^", "6"}], "x1"}], "+", 
    RowBox[{"1", "x2"}]}]}], ";", 
  RowBox[{"b3grph", "=", 
   RowBox[{"25", "*", 
    RowBox[{"10", "^", "6"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"g4", "[", 
     RowBox[{"x1_", ",", "x2_"}], "]"}], ":=", 

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g1", "[", 
    RowBox[{"x1_", ",", "x2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"20", "x1"}], "+", 
    RowBox[{"15", "x2"}]}]}], ";", 
  RowBox[{"b1", "=", "500"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g2", "[", 
    RowBox[{"x1_", ",", "x2_"}], "]"}], ":=", 
